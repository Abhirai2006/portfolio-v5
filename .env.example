# Public site URL (used for canonical / OG tags)
VITE_SITE_URL=https://<your-worker-name>.<your-subdomain>.workers.dev

# Supabase (client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# "Ask Abhishek" AI. Server-side only. Default: native Gemini API.
AI_API_KEY=
# AI_MODEL=gemini-flash-latest
# To use another OpenAI-compatible provider (Groq, OpenRouter, ...) set a base URL:
# AI_BASE_URL=https://api.groq.com/openai/v1

# Anime shelf recommendations database (publishable values)
VITE_ANIME_SUPABASE_URL=
VITE_ANIME_SUPABASE_PUBLISHABLE_KEY=
# ANIME_AI uses the same AI_API_KEY as the chat

# GitHub API token (Secret, server only). Optional; raises the rate limit for Live GitHub activity.
GITHUB_TOKEN=

# Cloudflare Worker name, only if yours is not "portfoli0" (must match the dashboard). Build variable.
# CF_WORKER_NAME=<your-worker-name>
